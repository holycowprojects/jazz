#!/usr/bin/env python3
"""jazz-font-set <ui-font> <mono-font>

Task 27 font-picker follow-up. Applies a UI/monospace font pair:
  - writes ~/.config/fontconfig/fonts.conf mapping the generic sans-serif/
    monospace families to the chosen fonts (the real Arch-native mechanism,
    per wiki.archlinux.org/title/Font_configuration - so GTK/Qt/anything
    that respects fontconfig aliases picks it up too, not just JAZZ's own
    shell), then runs fc-cache to apply it
  - writes $JAZZ_DATA_DIR/font-state.json - Theme.qml's FileView
    (watchChanges: true) picks this up live, same pattern as theme-state.json
    (Task 27b) - JAZZ's own shell.qml/Settings.qml PanelWindows set
    font.family: Theme.uiFont once at the top level and QML's font
    inheritance cascades it to every descendant Text/TextInput

Only the curated options in design/tokens/typography.json are meant to be
passed here - Settings' font dropdown is the only real caller.

Usage: jazz-font-set "<UI Font Family>" "<Mono Font Family>"
"""
import json
import os
import pathlib
import subprocess
import sys

DATA_DIR = pathlib.Path(os.environ.get("JAZZ_DATA_DIR", pathlib.Path.home() / ".local/share/jazz"))
FONTCONFIG_DIR = pathlib.Path.home() / ".config/fontconfig"


def write_fontconfig(ui_font, mono_font):
    FONTCONFIG_DIR.mkdir(parents=True, exist_ok=True)
    conf = """<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- GENERATED by jazz-font-set. Don't hand-edit, overwritten on every
     font change. Maps the generic sans-serif/monospace families to
     JAZZ's currently-selected fonts, per the ArchWiki's documented
     alias mechanism, so GTK/Qt apps (not just JAZZ's own shell) pick
     these up too. -->
<fontconfig>
  <alias>
    <family>sans-serif</family>
    <prefer><family>{ui}</family></prefer>
  </alias>
  <alias>
    <family>monospace</family>
    <prefer><family>{mono}</family></prefer>
  </alias>
</fontconfig>
""".format(ui=ui_font, mono=mono_font)
    (FONTCONFIG_DIR / "fonts.conf").write_text(conf)
    subprocess.run(["fc-cache", "-f"], capture_output=True)


def main():
    if len(sys.argv) != 3:
        sys.exit('Usage: jazz-font-set "<UI Font Family>" "<Mono Font Family>"')
    ui_font, mono_font = sys.argv[1], sys.argv[2]

    write_fontconfig(ui_font, mono_font)

    DATA_DIR.mkdir(parents=True, exist_ok=True)
    (DATA_DIR / "font-state.json").write_text(json.dumps({"uiFont": ui_font, "monoFont": mono_font}))

    print(f"Applied fonts: UI={ui_font}, Mono={mono_font}")


if __name__ == "__main__":
    main()
