#!/usr/bin/env python3
"""jazz-idle-set [--minutes N] [--enabled true|false] [--status]

Task 32's idle auto-lock. Self-service, no root needed - writes only to the
invoking user's own ~/.config/hypr/hypridle.conf and
$JAZZ_DATA_DIR/idle-settings.json, mirroring jazz-theme-set's own
DATA_DIR/per-user-config pattern.

hypridle has no live config-reload IPC (confirmed by its own CLI - no
`reload` subcommand), so a settings change means regenerate hypridle.conf
then kill+relaunch the daemon, same "no live-swap" shape jazz-wallpaper-set
already uses for swaybg.

Real mechanism confirmed live on the Yoga 6, 14 Sept 2026, before writing
this script: a short-timeout test listener block
(`on-timeout = pidof hyprlock || hyprlock`) genuinely triggered hyprlock and
locked a real Wayland session - confirmed via hypridle's own log line
("Wayland session got locked"), not assumed from the docs alone. The exact
listener/general block syntax below matches hypridle's real bundled sample
at /usr/share/hypr/hypridle.conf on this install (including this fork's
`hl.dsp.dpms({action = ...})` hyprctl dispatch syntax), not a generic
upstream example.

Usage:
    jazz-idle-set --minutes 10        # set lock timeout (minutes), regen + restart
    jazz-idle-set --enabled false     # disable idle-lock entirely (kills hypridle)
    jazz-idle-set --status            # print current settings as JSON, no changes
"""
import argparse
import json
import os
import pathlib
import pwd
import subprocess
import sys
import time

DATA_DIR = pathlib.Path(os.environ.get("JAZZ_DATA_DIR", pathlib.Path.home() / ".local/share/jazz"))
SETTINGS_FILE = DATA_DIR / "idle-settings.json"
HYPR_DIR = pathlib.Path.home() / ".config/hypr"
CONF_FILE = HYPR_DIR / "hypridle.conf"
DEFAULTS = {"enabled": True, "minutes": 10}


def load():
    if SETTINGS_FILE.exists():
        try:
            saved = json.loads(SETTINGS_FILE.read_text())
            return {**DEFAULTS, **saved}
        except (json.JSONDecodeError, OSError):
            pass
    return dict(DEFAULTS)


def save(settings):
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    SETTINGS_FILE.write_text(json.dumps(settings, indent=2))


def write_conf(settings):
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    lock_timeout = max(1, int(settings["minutes"])) * 60
    # Screen-off is a fixed 5-minute offset after the lock, not a second
    # user-configurable timeout - the spec only asked for the lock timeout
    # itself to be adjustable, a second tunable nobody asked for would be
    # unused complexity.
    dpms_timeout = lock_timeout + 300
    conf = f"""# Generated by jazz-idle-set - hand-edits are overwritten on the next
# Settings change (Jazz Settings > Users > Idle lock). See scripts/jazz-idle-set.
general {{
    lock_cmd = pidof hyprlock || hyprlock
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({{action = "on"}})'
}}

listener {{
    timeout = {lock_timeout}
    on-timeout = pidof hyprlock || hyprlock
}}

listener {{
    timeout = {dpms_timeout}
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({{action = "off"}})'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({{action = "on"}})'
}}
"""
    CONF_FILE.write_text(conf)


def restart_hypridle(enabled):
    username = pwd.getpwuid(os.getuid()).pw_name
    subprocess.run(["pkill", "-u", username, "-x", "hypridle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.3)
    if enabled:
        # Best-effort: if there's no live Wayland session yet (e.g. seeded
        # during account provisioning before first login), this process
        # exits immediately with no session to connect to - harmless, the
        # real launch happens via hyprland.lua's own autostart hook at
        # next login.
        subprocess.Popen(
            ["hypridle"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
            start_new_session=True,
        )


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--minutes", type=int)
    p.add_argument("--enabled", choices=["true", "false"])
    p.add_argument("--status", action="store_true")
    args = p.parse_args()

    settings = load()
    if args.status:
        print(json.dumps(settings))
        return

    if args.minutes is not None:
        if args.minutes < 1:
            sys.exit("error: --minutes must be >= 1")
        settings["minutes"] = args.minutes
    if args.enabled is not None:
        settings["enabled"] = args.enabled == "true"

    save(settings)
    write_conf(settings)
    restart_hypridle(settings["enabled"])
    print(json.dumps(settings))


if __name__ == "__main__":
    main()
