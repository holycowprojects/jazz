#!/usr/bin/env python3
"""jazz-theme-set <theme-id> [--variant N]

Task 27b's orchestrator - the real "bundle compiler". Applies a theme from
design/tokens/themes.json (deployed to $JAZZ_DATA_DIR/themes.json) across:
  - kitty        (writes ~/.config/kitty/jazz-theme.conf, live-reloads any
                   open kitty windows via remote control if enabled)
  - hyprlock     (writes ~/.config/hypr/hyprlock.conf)
  - dunst        (writes ~/.config/dunst/dunstrc, reloads the running daemon)
  - wallpaper    (calls the existing jazz-wallpaper-set helper, Task 23)
  - Kvantum      (Task 27e: writes ~/.config/Kvantum/Jazz-<id>/, a real
                   per-theme Qt widget style generated from a vendored
                   KvArcDark template - see configs/kvantum/SOURCE.md)
  - GTK3         (Task 27e: writes ~/.config/gtk-3.0/settings.ini,
                   picking adw-gtk3 or adw-gtk3-dark by theme mode)
  - Quickshell   (writes $JAZZ_DATA_DIR/theme-state.json - Theme.qml's
                   FileView (watchChanges: true) picks it up live, confirmed
                   8 Sept 2026 on the Yoga 6 by sampling actual dock pixel
                   colors before/after a switch, no relaunch needed. An
                   earlier live check seemed to show this NOT working, but
                   that was a misread: the top bar stayed the active
                   WORKSPACE's color (Forge blue) across every theme switch,
                   which is correct by design - workspace colors are
                   constant across themes (Design-Vision.md sec 2), only
                   chrome (surface/text/dock) is theme-controlled. Pixel-
                   sampled the dock instead of eyeballing it and confirmed
                   the live switch genuinely works with zero relaunch.

Python3 stdlib only, no new dependency - same choice already made for
jazz-agent-action (Task 30).

Task 27d: --from-wallpaper PATH derives the accent from a real image via
matugen (confirmed official `extra` repo) instead of themes.json's
configured accent, reading its 'source_color' role (the actual extracted
swatch, not Material You's tone-shifted 'primary' role meant for
foreground text) and rejecting it via validate_accent_candidate() before
it ever reaches Theme.qml if it's too dark/light, too desaturated, or too
low-contrast against the white fill-text JAZZ's buttons already use. This
only affects the current invocation in memory - themes.json on disk (the
theme's canonical accent) is never overwritten.

Usage (on the installed guest, as the desktop user):
    jazz-theme-set <theme-id> [--variant N]
    jazz-theme-set <theme-id> --from-wallpaper <path>
    jazz-theme-set --list
"""
import argparse
import copy
import json
import os
import pathlib
import re
import subprocess
import sys

DATA_DIR = pathlib.Path(os.environ.get("JAZZ_DATA_DIR", pathlib.Path.home() / ".local/share/jazz"))
THEMES_JSON = DATA_DIR / "themes.json"
WALLPAPER_DIR = DATA_DIR / "wallpapers"
KITTY_DIR = pathlib.Path.home() / ".config/kitty"
HYPR_DIR = pathlib.Path.home() / ".config/hypr"
DUNST_DIR = pathlib.Path.home() / ".config/dunst"
KVANTUM_BASE_DIR = DATA_DIR / "kvantum-base"
KVANTUM_CONFIG_DIR = pathlib.Path.home() / ".config/Kvantum"
GTK3_DIR = pathlib.Path.home() / ".config/gtk-3.0"


def load_themes():
    if not THEMES_JSON.exists():
        sys.exit(f"error: {THEMES_JSON} not found - run scripts/setup-theme.sh first")
    return json.loads(THEMES_JSON.read_text())["themes"]


def write_kitty(theme_id, t):
    term = t["terminal"]
    KITTY_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        f"# GENERATED by jazz-theme-set - theme: {theme_id}. Don't hand-edit,",
        "# it's overwritten on every theme switch. Included from kitty.conf.",
        f'background {term["background"]}',
        f'foreground {term["foreground"]}',
        f'cursor {term["cursor"]}',
        f'selection_background {t["accent"]}',
    ]
    order = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    for i, name in enumerate(order):
        lines.append(f"color{i} {term[name]}")
    for i, name in enumerate(order):
        lines.append(f"color{8 + i} {term['bright_' + name]}")
    theme_path = KITTY_DIR / "jazz-theme.conf"
    theme_path.write_text("\n".join(lines) + "\n")

    base_conf = KITTY_DIR / "kitty.conf"
    marker = "# Added by jazz-theme-set (Task 27b)"
    if not base_conf.exists() or marker not in base_conf.read_text():
        with open(base_conf, "a") as f:
            f.write(f"\n{marker}: base kitty config + live theme switching.\n")
            f.write("allow_remote_control yes\n")
            f.write("listen_on unix:/tmp/jazz-kitty.sock\n")
            f.write("include jazz-theme.conf\n")

    # Live-reload any already-open kitty windows - best-effort, kitty may not
    # be running yet, that's fine, the config file is already correct for
    # the next window it opens.
    subprocess.run(
        ["kitty", "@", "--to", "unix:/tmp/jazz-kitty.sock", "set-colors", "--all", str(theme_path)],
        capture_output=True,
    )


def write_hyprlock(theme_id, t, wallpaper_path):
    c = t["chrome"]
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    conf = f"""# GENERATED by jazz-theme-set - theme: {theme_id}. Don't hand-edit.
background {{
    path = {wallpaper_path}
    blur_passes = 3
    blur_size = 8
    noise = 0.02
    contrast = 0.9
    brightness = 0.75
}}

input-field {{
    size = 260, 52
    outline_thickness = 2
    dots_size = 0.25
    outer_color = rgba({int(t['accent'][1:3],16)}, {int(t['accent'][3:5],16)}, {int(t['accent'][5:7],16)}, 1.0)
    inner_color = rgba({int(c['surfaceRaised'][1:3],16)}, {int(c['surfaceRaised'][3:5],16)}, {int(c['surfaceRaised'][5:7],16)}, 0.9)
    font_color = rgba({int(c['textPrimary'][1:3],16)}, {int(c['textPrimary'][3:5],16)}, {int(c['textPrimary'][5:7],16)}, 1.0)
    placeholder_text = <span foreground="##{c['textSecondary'][1:]}">Password...</span>
    fade_on_empty = true
    position = 0, -80
    halign = center
    valign = center
}}

label {{
    text = Welcome to <span font_weight="bold">JAZZ</span>
    color = rgba({int(c['textPrimary'][1:3],16)}, {int(c['textPrimary'][3:5],16)}, {int(c['textPrimary'][5:7],16)}, 1.0)
    font_size = 24
    font_family = sans-serif
    position = 0, 220
    halign = center
    valign = center
}}

label {{
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba({int(c['textPrimary'][1:3],16)}, {int(c['textPrimary'][3:5],16)}, {int(c['textPrimary'][5:7],16)}, 1.0)
    font_size = 64
    font_family = sans-serif
    position = 0, 120
    halign = center
    valign = center
}}

label {{
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = rgba({int(c['textSecondary'][1:3],16)}, {int(c['textSecondary'][3:5],16)}, {int(c['textSecondary'][5:7],16)}, 1.0)
    font_size = 18
    font_family = sans-serif
    position = 0, 60
    halign = center
    valign = center
}}

label {{
    # Task 32, 14 Sept 2026: prefers the real display name (GECOS full name,
    # settable via Settings > Users > My Display Name) over the raw login
    # username. GECOS's comma-separated room/phone fields (the standard
    # useradd format) are cut off with `cut -d, -f1`; an empty/unset GECOS
    # falls back to `whoami` via `sed`, one pipeline, no semicolons - kept
    # deliberately simple since a malformed hyprlock.conf can break the
    # lock screen for real (confirmed live, Task 11's own lesson).
    text = cmd[update:3600000] getent passwd "$(whoami)" | cut -d: -f5 | cut -d, -f1 | sed "s/^$/$(whoami)/"
    color = rgba({int(c['textSecondary'][1:3],16)}, {int(c['textSecondary'][3:5],16)}, {int(c['textSecondary'][5:7],16)}, 1.0)
    font_size = 18
    font_family = sans-serif
    position = 0, -20
    halign = center
    valign = center
}}
"""
    (HYPR_DIR / "hyprlock.conf").write_text(conf)


def write_dunst(theme_id, t):
    c = t["chrome"]
    DUNST_DIR.mkdir(parents=True, exist_ok=True)
    conf = f"""# GENERATED by jazz-theme-set - theme: {theme_id}. Don't hand-edit.
[global]
    width = 320
    height = 300
    origin = top-right
    offset = 12x46
    frame_width = 1
    frame_color = "{t['accent']}"
    gap_size = 6
    corner_radius = 8
    font = sans-serif 10
    format = "<b>%s</b>\\n%b"
    padding = 12
    horizontal_padding = 12

[urgency_low]
    background = "{c['surface']}"
    foreground = "{c['textSecondary']}"
    frame_color = "{c['surfaceRaised']}"
    timeout = 4

[urgency_normal]
    background = "{c['surface']}"
    foreground = "{c['textPrimary']}"
    frame_color = "{t['accent']}"
    timeout = 6

[urgency_critical]
    background = "{c['surface']}"
    foreground = "{c['textPrimary']}"
    frame_color = "#a23a3a"
    timeout = 0
"""
    (DUNST_DIR / "dunstrc").write_text(conf)
    subprocess.run(["dunstctl", "reload"], capture_output=True)


def _hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def _rgb_to_hex(rgb):
    return "#" + "".join(f"{max(0, min(255, round(c))):02x}" for c in rgb)


def _lighten(hex_color, factor):
    r, g, b = _hex_to_rgb(hex_color)
    return _rgb_to_hex((r * factor, g * factor, b * factor))


def _darken(hex_color, factor):
    return _lighten(hex_color, factor)


def _hsv(hex_color):
    r, g, b = (c / 255.0 for c in _hex_to_rgb(hex_color))
    maxc, minc = max(r, g, b), min(r, g, b)
    v = maxc
    s = 0.0 if maxc == 0 else (maxc - minc) / maxc
    return s, v


def _relative_luminance(hex_color):
    """Simplified WCAG-style relative luminance (sRGB, no gamma linearization -
    a real, meaningfully-ordered proxy, not exact WCAG, but the task's own bar
    is 'contrast-tested, not raw Matugen output', not pixel-perfect WCAG."""
    r, g, b = (c / 255.0 for c in _hex_to_rgb(hex_color))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _contrast_ratio(hex_a, hex_b):
    la, lb = _relative_luminance(hex_a), _relative_luminance(hex_b)
    lighter, darker = max(la, lb), min(la, lb)
    return (lighter + 0.05) / (darker + 0.05)


def validate_accent_candidate(hex_color):
    """Task 27d's real validation layer - rejects a raw Matugen candidate
    before it ever reaches Theme.qml, per the task's explicit requirement
    that raw Matugen output must never directly override JAZZ's accent
    unchecked. Three real checks, not cosmetic ones:
    - too dark/too light to read as a distinct accent swatch at all
    - too desaturated (muddy/gray) to look intentional, not just noise
      the extraction algorithm happened to settle on
    - insufficient contrast against white (JAZZ's buttons/fills put white
      text on top of the accent color - Button.qml's own convention,
      confirmed elsewhere in the project - so this is the same real
      constraint the UI itself already depends on, not an invented one)
    Returns (accepted_hex_or_None, rejection_reason_or_None).
    """
    s, v = _hsv(hex_color)
    if v < 0.15 or v > 0.92:
        return None, f"lightness out of range (v={v:.2f}, need 0.15-0.92)"
    if s < 0.22:
        return None, f"too desaturated to read as an intentional accent (s={s:.2f}, need >=0.22)"
    contrast = _contrast_ratio(hex_color, "#ffffff")
    if contrast < 2.0:
        return None, f"insufficient contrast against white fill-text ({contrast:.2f}:1, need >=2.0:1)"
    return hex_color, None


def derive_accent_from_wallpaper(image_path, mode):
    """Task 27d. Shells out to matugen (confirmed official `extra` repo
    package) against a real wallpaper file and returns its raw
    'source_color' role - the actual extracted dominant swatch, not
    Material You's tone-shifted 'primary' role (which is remapped for
    on-dark/on-light FOREGROUND text contrast in Google's own design
    system, not for use as a flat fill color the way JAZZ's accent is
    used - confirmed by inspecting real output against Forge's own
    wallpaper before choosing which role to read). Falls back to
    'primary' only if 'source_color' is missing (a version-robustness
    guard, not the primary path). Returns None on any failure - matugen
    missing, a malformed image, unexpected JSON shape - so the caller can
    fall back to the theme's own configured accent rather than crash.
    """
    try:
        result = subprocess.run(
            ["matugen", "image", str(image_path), "--source-color-index", "0",
             "-m", mode, "-j", "hex", "--dry-run"],
            capture_output=True, text=True, timeout=30, check=True,
        )
        data = json.loads(result.stdout)
        colors = data["colors"]
        if "source_color" in colors:
            return colors["source_color"][mode]["color"]
        return colors["primary"][mode]["color"]
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired,
            FileNotFoundError, json.JSONDecodeError, KeyError) as e:
        print(f"warning: matugen extraction failed ({e}), keeping theme's own accent", file=sys.stderr)
        return None


def write_kvantum(theme_id, t):
    """Task 27e/27d. Generates a real Kvantum theme from KvArcDark's
    vendored template (configs/kvantum/JazzBase.{kvconfig,svg}, deployed to
    $JAZZ_DATA_DIR/kvantum-base by setup-kvantum.sh).

    Correction (found live, 12 Sept 2026, while proving Task 27d's derived
    accent actually renders): the .kvconfig's [GeneralColors] substitution
    alone is NOT sufficient - a pixel-sample of a real rendered checkbox
    showed it still using KvArcDark's original #5294e2, not the theme's
    accent. Root cause: KvArcDark.svg bakes its accent-blue family directly
    into ~65 shape fills (checkbox ticks, focus rings, slider handles) -
    Kvantum does NOT universally tint shared shapes from [GeneralColors] at
    render time the way the .kvconfig-only pass assumed; only background/
    text-role fills work that way. So the .svg itself also needs the same
    accent-family literals substituted, not just copied unmodified. Left
    #b74aff (a distinct purple, unrelated hue, only 4 occurrences) alone -
    no evidence it's meant to track the theme accent, and blindly
    substituting an unconfirmed color risks a new, unverified visual bug.
    """
    template_path = KVANTUM_BASE_DIR / "JazzBase.kvconfig"
    svg_path = KVANTUM_BASE_DIR / "JazzBase.svg"
    if not template_path.exists() or not svg_path.exists():
        print(f"warning: {KVANTUM_BASE_DIR} missing base theme, skipped Kvantum", file=sys.stderr)
        return

    c = t["chrome"]
    accent = t["accent"]
    is_light = t["mode"] == "light"

    window_c = c["surface"]
    base_c = "#ffffff" if is_light else c["surfaceRaised"]
    altbase_c = c["surfaceRaised"]
    button_c = c["surfaceRaised"]
    light_c = _lighten(accent, 1.35)
    midlight_c = _darken(c["surface"], 0.92 if is_light else 0.85)
    dark_c = _darken(c["surface"], 0.35 if is_light else 0.05) if is_light else "black"
    mid_c = _darken(c["surface"], 0.6)
    accent_focus_c = _lighten(accent, 1.15)

    content = template_path.read_text()

    # Blanket substitutions run FIRST, against the raw template only - they
    # must never touch anything the key-based pass below writes (a real bug
    # caught testing Daylight: base.color's own "#ffffff" for light mode was
    # getting re-matched and overwritten by this same #ffffffXX->textPrimary
    # rule when it ran second, since "#ffffff" with no alpha suffix is a
    # valid match for both purposes).
    content = content.replace("#5294e2", accent)
    content = content.replace("#5796e8", accent_focus_c)
    content = content.replace("#eefcff", c["textPrimary"])
    content = re.sub(
        r"#ffffff([0-9a-fA-F]{2})?",
        lambda m: c["textPrimary"] + (m.group(1) or ""),
        content,
    )

    key_subs = {
        "window.color": window_c,
        "base.color": base_c,
        "alt.base.color": altbase_c,
        "button.color": button_c,
        "light.color": light_c,
        "mid.light.color": midlight_c,
        "dark.color": dark_c,
        "mid.color": mid_c,
        "highlight.color": accent,
        "inactive.highlight.color": accent,
        "link.color": accent,
    }
    for key, val in key_subs.items():
        pattern = rf"^{re.escape(key)}=.*$"
        content = re.sub(pattern, f"{key}={val}", content, count=1, flags=re.MULTILINE)

    svg_content = svg_path.read_text()
    svg_content = svg_content.replace("#5294e2", accent)
    svg_content = svg_content.replace("#4693e6", accent)
    svg_content = svg_content.replace("#58acff", light_c)

    theme_name = f"Jazz-{theme_id}"
    out_dir = KVANTUM_CONFIG_DIR / theme_name
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / f"{theme_name}.kvconfig").write_text(content)
    (out_dir / f"{theme_name}.svg").write_text(svg_content)

    KVANTUM_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    (KVANTUM_CONFIG_DIR / "kvantum.kvconfig").write_text(f"[General]\ntheme={theme_name}\n")


def write_gtk3(t):
    """Task 27e. adw-gtk-theme (official repo) ships both a light and a
    dark variant - picks the one matching this theme's own mode, so
    Daylight (JAZZ's one light theme) doesn't get stuck with a dark GTK3
    look. Kvantum handles the Qt side; this is GTK3's equivalent switch.
    """
    gtk_theme = "adw-gtk3" if t["mode"] == "light" else "adw-gtk3-dark"
    GTK3_DIR.mkdir(parents=True, exist_ok=True)
    conf = f"[Settings]\ngtk-theme-name={gtk_theme}\ngtk-application-prefer-dark-theme={'false' if t['mode'] == 'light' else 'true'}\n"
    (GTK3_DIR / "settings.ini").write_text(conf)


LY_STATE_FILE = pathlib.Path("/var/lib/jazz/ly-theme.json")


def write_ly_state(t):
    """Task 33: ly (the login greeter)'s config.ini lives in /etc, so this
    self-service, no-root script can't write it directly - instead it drops
    the chosen theme's colors in a small world-writable state file
    (seeded at mode 0666 by setup-ly-theme.sh, so a plain truncate-write to
    the existing file works for any user, no sudo/sticky-bit tricks
    needed). A systemd drop-in on ly@.service (also from setup-ly-theme.sh)
    runs jazz-ly-theme-sync (root) right before the greeter starts, applying
    these colors to config.ini - so ly always reflects whichever theme was
    MOST RECENTLY applied by ANY user, matching this machine's single-real-
    desktop-user framing (Task 33's own scope). accent is used for
    border_fg (matches hyprlock's own accent-colored input outline) and
    terminal.red for error_fg (already tuned to this theme's palette,
    better than a generic clashing red). Best-effort: if
    /var/lib/jazz doesn't exist yet (setup-ly-theme.sh hasn't run - e.g. an
    older install not yet updated), this silently does nothing rather than
    crashing theme-switching over a login-screen cosmetic.
    """
    try:
        LY_STATE_FILE.write_text(json.dumps({
            "bg": t["chrome"]["surface"],
            "fg": t["chrome"]["textPrimary"],
            "border": t["accent"],
            "error": t["terminal"]["red"],
        }))
    except OSError:
        pass


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("theme_id", nargs="?")
    ap.add_argument("--variant", type=int, default=0)
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--restore", action="store_true", help="reapply the persisted theme-state.json choice - for autostart, so a reboot doesn't silently revert the wallpaper to Forge while Theme.qml correctly restores the last chrome")
    ap.add_argument("--from-wallpaper", metavar="PATH", help="Task 27d: derive the accent from this image via matugen instead of themes.json's configured accent, subject to validate_accent_candidate() - rejected candidates fall back to the theme's own accent, printed to stderr, never silently substituted")
    args = ap.parse_args()

    themes = load_themes()

    if args.list:
        for tid, t in themes.items():
            print(f"{tid}\t{t['label']}\t{t['mode']}")
        return

    if args.restore:
        state_file = DATA_DIR / "theme-state.json"
        args.theme_id = "forge"
        if state_file.exists():
            try:
                args.theme_id = json.loads(state_file.read_text()).get("activeTheme", "forge")
            except (json.JSONDecodeError, OSError):
                pass

    if not args.theme_id or args.theme_id not in themes:
        sys.exit(f"error: unknown theme '{args.theme_id}'. Known: {', '.join(themes)}")

    t = themes[args.theme_id]
    wp_list = t["wallpapers"]
    wp_entry = wp_list[min(args.variant, len(wp_list) - 1)]
    wallpaper_path = WALLPAPER_DIR / wp_entry["path"]

    if args.from_wallpaper:
        raw = derive_accent_from_wallpaper(args.from_wallpaper, t["mode"])
        if raw is not None:
            validated, reason = validate_accent_candidate(raw)
            if validated:
                print(f"Matugen: {args.from_wallpaper} -> {raw}, accepted as accent")
                t = copy.deepcopy(t)
                t["accent"] = validated
                t["terminal"]["cursor"] = validated
            else:
                print(f"Matugen: {args.from_wallpaper} -> {raw}, REJECTED ({reason}) - keeping {t['accent']}", file=sys.stderr)

    write_kitty(args.theme_id, t)
    write_hyprlock(args.theme_id, t, wallpaper_path)
    write_dunst(args.theme_id, t)
    write_kvantum(args.theme_id, t)
    write_gtk3(t)
    write_ly_state(t)

    if wallpaper_path.exists():
        subprocess.run(["jazz-wallpaper-set", str(wallpaper_path)], check=False)
    else:
        print(f"warning: wallpaper {wallpaper_path} missing, skipped wallpaper apply", file=sys.stderr)

    DATA_DIR.mkdir(parents=True, exist_ok=True)
    (DATA_DIR / "theme-state.json").write_text(json.dumps({"activeTheme": args.theme_id}))
    # No Quickshell relaunch needed here - Theme.qml's FileView (watchChanges)
    # picks this up live, confirmed live on the Yoga 6 via pixel sampling.

    print(f"Applied theme: {t['label']} ({args.theme_id})")


if __name__ == "__main__":
    main()
