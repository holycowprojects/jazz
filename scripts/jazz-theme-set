#!/usr/bin/env python3
"""jazz-theme-set <theme-id> [--variant N]

Task 27b's orchestrator - the real "bundle compiler". Applies a theme from
design/tokens/themes.json (deployed to $JAZZ_DATA_DIR/themes.json) across:
  - kitty        (writes ~/.config/kitty/jazz-theme.conf, live-reloads any
                   open kitty windows via remote control if enabled)
  - hyprlock     (writes ~/.config/hypr/hyprlock.conf)
  - dunst        (writes ~/.config/dunst/dunstrc, reloads the running daemon)
  - wallpaper    (calls the existing jazz-wallpaper-set helper, Task 23)
  - Kvantum      (Task 27e: writes ~/.config/Kvantum/Jazz-<id>/, a real
                   per-theme Qt widget style generated from a vendored
                   KvArcDark template - see configs/kvantum/SOURCE.md)
  - GTK3         (Task 27e: writes ~/.config/gtk-3.0/settings.ini,
                   picking adw-gtk3 or adw-gtk3-dark by theme mode)
  - Quickshell   (writes $JAZZ_DATA_DIR/theme-state.json - Theme.qml's
                   FileView (watchChanges: true) picks it up live, confirmed
                   8 Sept 2026 on the Yoga 6 by sampling actual dock pixel
                   colors before/after a switch, no relaunch needed. An
                   earlier live check seemed to show this NOT working, but
                   that was a misread: the top bar stayed the active
                   WORKSPACE's color (Forge blue) across every theme switch,
                   which is correct by design - workspace colors are
                   constant across themes (Design-Vision.md sec 2), only
                   chrome (surface/text/dock) is theme-controlled. Pixel-
                   sampled the dock instead of eyeballing it and confirmed
                   the live switch genuinely works with zero relaunch.

Python3 stdlib only, no new dependency - same choice already made for
jazz-agent-action (Task 30).

Usage (on the installed guest, as the desktop user):
    jazz-theme-set <theme-id> [--variant N]
    jazz-theme-set --list
"""
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

DATA_DIR = pathlib.Path(os.environ.get("JAZZ_DATA_DIR", pathlib.Path.home() / ".local/share/jazz"))
THEMES_JSON = DATA_DIR / "themes.json"
WALLPAPER_DIR = DATA_DIR / "wallpapers"
KITTY_DIR = pathlib.Path.home() / ".config/kitty"
HYPR_DIR = pathlib.Path.home() / ".config/hypr"
DUNST_DIR = pathlib.Path.home() / ".config/dunst"
KVANTUM_BASE_DIR = DATA_DIR / "kvantum-base"
KVANTUM_CONFIG_DIR = pathlib.Path.home() / ".config/Kvantum"
GTK3_DIR = pathlib.Path.home() / ".config/gtk-3.0"


def load_themes():
    if not THEMES_JSON.exists():
        sys.exit(f"error: {THEMES_JSON} not found - run scripts/setup-theme.sh first")
    return json.loads(THEMES_JSON.read_text())["themes"]


def write_kitty(theme_id, t):
    term = t["terminal"]
    KITTY_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        f"# GENERATED by jazz-theme-set - theme: {theme_id}. Don't hand-edit,",
        "# it's overwritten on every theme switch. Included from kitty.conf.",
        f'background {term["background"]}',
        f'foreground {term["foreground"]}',
        f'cursor {term["cursor"]}',
        f'selection_background {t["accent"]}',
    ]
    order = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    for i, name in enumerate(order):
        lines.append(f"color{i} {term[name]}")
    for i, name in enumerate(order):
        lines.append(f"color{8 + i} {term['bright_' + name]}")
    theme_path = KITTY_DIR / "jazz-theme.conf"
    theme_path.write_text("\n".join(lines) + "\n")

    base_conf = KITTY_DIR / "kitty.conf"
    marker = "# Added by jazz-theme-set (Task 27b)"
    if not base_conf.exists() or marker not in base_conf.read_text():
        with open(base_conf, "a") as f:
            f.write(f"\n{marker}: base kitty config + live theme switching.\n")
            f.write("allow_remote_control yes\n")
            f.write("listen_on unix:/tmp/jazz-kitty.sock\n")
            f.write("include jazz-theme.conf\n")

    # Live-reload any already-open kitty windows - best-effort, kitty may not
    # be running yet, that's fine, the config file is already correct for
    # the next window it opens.
    subprocess.run(
        ["kitty", "@", "--to", "unix:/tmp/jazz-kitty.sock", "set-colors", "--all", str(theme_path)],
        capture_output=True,
    )


def write_hyprlock(theme_id, t, wallpaper_path):
    c = t["chrome"]
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    conf = f"""# GENERATED by jazz-theme-set - theme: {theme_id}. Don't hand-edit.
background {{
    path = {wallpaper_path}
    blur_passes = 3
    blur_size = 8
    noise = 0.02
    contrast = 0.9
    brightness = 0.75
}}

input-field {{
    size = 260, 52
    outline_thickness = 2
    dots_size = 0.25
    outer_color = rgba({int(t['accent'][1:3],16)}, {int(t['accent'][3:5],16)}, {int(t['accent'][5:7],16)}, 1.0)
    inner_color = rgba({int(c['surfaceRaised'][1:3],16)}, {int(c['surfaceRaised'][3:5],16)}, {int(c['surfaceRaised'][5:7],16)}, 0.9)
    font_color = rgba({int(c['textPrimary'][1:3],16)}, {int(c['textPrimary'][3:5],16)}, {int(c['textPrimary'][5:7],16)}, 1.0)
    placeholder_text = <span foreground="##{c['textSecondary'][1:]}">Password...</span>
    fade_on_empty = true
    position = 0, -80
    halign = center
    valign = center
}}

label {{
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba({int(c['textPrimary'][1:3],16)}, {int(c['textPrimary'][3:5],16)}, {int(c['textPrimary'][5:7],16)}, 1.0)
    font_size = 64
    font_family = sans-serif
    position = 0, 120
    halign = center
    valign = center
}}

label {{
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = rgba({int(c['textSecondary'][1:3],16)}, {int(c['textSecondary'][3:5],16)}, {int(c['textSecondary'][5:7],16)}, 1.0)
    font_size = 18
    font_family = sans-serif
    position = 0, 60
    halign = center
    valign = center
}}
"""
    (HYPR_DIR / "hyprlock.conf").write_text(conf)


def write_dunst(theme_id, t):
    c = t["chrome"]
    DUNST_DIR.mkdir(parents=True, exist_ok=True)
    conf = f"""# GENERATED by jazz-theme-set - theme: {theme_id}. Don't hand-edit.
[global]
    width = 320
    height = 300
    origin = top-right
    offset = 12x46
    frame_width = 1
    frame_color = "{t['accent']}"
    gap_size = 6
    corner_radius = 8
    font = sans-serif 10
    format = "<b>%s</b>\\n%b"
    padding = 12
    horizontal_padding = 12

[urgency_low]
    background = "{c['surface']}"
    foreground = "{c['textSecondary']}"
    frame_color = "{c['surfaceRaised']}"
    timeout = 4

[urgency_normal]
    background = "{c['surface']}"
    foreground = "{c['textPrimary']}"
    frame_color = "{t['accent']}"
    timeout = 6

[urgency_critical]
    background = "{c['surface']}"
    foreground = "{c['textPrimary']}"
    frame_color = "#a23a3a"
    timeout = 0
"""
    (DUNST_DIR / "dunstrc").write_text(conf)
    subprocess.run(["dunstctl", "reload"], capture_output=True)


def _hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def _rgb_to_hex(rgb):
    return "#" + "".join(f"{max(0, min(255, round(c))):02x}" for c in rgb)


def _lighten(hex_color, factor):
    r, g, b = _hex_to_rgb(hex_color)
    return _rgb_to_hex((r * factor, g * factor, b * factor))


def _darken(hex_color, factor):
    return _lighten(hex_color, factor)


def write_kvantum(theme_id, t):
    """Task 27e. Generates a real Kvantum theme from KvArcDark's vendored
    template (configs/kvantum/JazzBase.{kvconfig,svg}, deployed to
    $JAZZ_DATA_DIR/kvantum-base by setup-kvantum.sh) - the SVG asset is
    reused unmodified (Kvantum tints its shared shapes from the
    [GeneralColors] hex values at render time, confirmed by inspecting the
    installed package, not guessed), only the .kvconfig's color values are
    substituted per-theme via targeted key regex (GeneralColors block) plus
    two known accent-lookalike literals KvArcDark hardcodes outside that
    block (#5294e2, #5796e8) and its #ffffffXX text-color placeholders.
    """
    template_path = KVANTUM_BASE_DIR / "JazzBase.kvconfig"
    svg_path = KVANTUM_BASE_DIR / "JazzBase.svg"
    if not template_path.exists() or not svg_path.exists():
        print(f"warning: {KVANTUM_BASE_DIR} missing base theme, skipped Kvantum", file=sys.stderr)
        return

    c = t["chrome"]
    accent = t["accent"]
    is_light = t["mode"] == "light"

    window_c = c["surface"]
    base_c = "#ffffff" if is_light else c["surfaceRaised"]
    altbase_c = c["surfaceRaised"]
    button_c = c["surfaceRaised"]
    light_c = _lighten(accent, 1.35)
    midlight_c = _darken(c["surface"], 0.92 if is_light else 0.85)
    dark_c = _darken(c["surface"], 0.35 if is_light else 0.05) if is_light else "black"
    mid_c = _darken(c["surface"], 0.6)
    accent_focus_c = _lighten(accent, 1.15)

    content = template_path.read_text()

    # Blanket substitutions run FIRST, against the raw template only - they
    # must never touch anything the key-based pass below writes (a real bug
    # caught testing Daylight: base.color's own "#ffffff" for light mode was
    # getting re-matched and overwritten by this same #ffffffXX->textPrimary
    # rule when it ran second, since "#ffffff" with no alpha suffix is a
    # valid match for both purposes).
    content = content.replace("#5294e2", accent)
    content = content.replace("#5796e8", accent_focus_c)
    content = content.replace("#eefcff", c["textPrimary"])
    content = re.sub(
        r"#ffffff([0-9a-fA-F]{2})?",
        lambda m: c["textPrimary"] + (m.group(1) or ""),
        content,
    )

    key_subs = {
        "window.color": window_c,
        "base.color": base_c,
        "alt.base.color": altbase_c,
        "button.color": button_c,
        "light.color": light_c,
        "mid.light.color": midlight_c,
        "dark.color": dark_c,
        "mid.color": mid_c,
        "highlight.color": accent,
        "inactive.highlight.color": accent,
        "link.color": accent,
    }
    for key, val in key_subs.items():
        pattern = rf"^{re.escape(key)}=.*$"
        content = re.sub(pattern, f"{key}={val}", content, count=1, flags=re.MULTILINE)

    theme_name = f"Jazz-{theme_id}"
    out_dir = KVANTUM_CONFIG_DIR / theme_name
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / f"{theme_name}.kvconfig").write_text(content)
    (out_dir / f"{theme_name}.svg").write_bytes(svg_path.read_bytes())

    KVANTUM_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    (KVANTUM_CONFIG_DIR / "kvantum.kvconfig").write_text(f"[General]\ntheme={theme_name}\n")


def write_gtk3(t):
    """Task 27e. adw-gtk-theme (official repo) ships both a light and a
    dark variant - picks the one matching this theme's own mode, so
    Daylight (JAZZ's one light theme) doesn't get stuck with a dark GTK3
    look. Kvantum handles the Qt side; this is GTK3's equivalent switch.
    """
    gtk_theme = "adw-gtk3" if t["mode"] == "light" else "adw-gtk3-dark"
    GTK3_DIR.mkdir(parents=True, exist_ok=True)
    conf = f"[Settings]\ngtk-theme-name={gtk_theme}\ngtk-application-prefer-dark-theme={'false' if t['mode'] == 'light' else 'true'}\n"
    (GTK3_DIR / "settings.ini").write_text(conf)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("theme_id", nargs="?")
    ap.add_argument("--variant", type=int, default=0)
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--restore", action="store_true", help="reapply the persisted theme-state.json choice - for autostart, so a reboot doesn't silently revert the wallpaper to Forge while Theme.qml correctly restores the last chrome")
    args = ap.parse_args()

    themes = load_themes()

    if args.list:
        for tid, t in themes.items():
            print(f"{tid}\t{t['label']}\t{t['mode']}")
        return

    if args.restore:
        state_file = DATA_DIR / "theme-state.json"
        args.theme_id = "forge"
        if state_file.exists():
            try:
                args.theme_id = json.loads(state_file.read_text()).get("activeTheme", "forge")
            except (json.JSONDecodeError, OSError):
                pass

    if not args.theme_id or args.theme_id not in themes:
        sys.exit(f"error: unknown theme '{args.theme_id}'. Known: {', '.join(themes)}")

    t = themes[args.theme_id]
    wp_list = t["wallpapers"]
    wp_entry = wp_list[min(args.variant, len(wp_list) - 1)]
    wallpaper_path = WALLPAPER_DIR / wp_entry["path"]

    write_kitty(args.theme_id, t)
    write_hyprlock(args.theme_id, t, wallpaper_path)
    write_dunst(args.theme_id, t)
    write_kvantum(args.theme_id, t)
    write_gtk3(t)

    if wallpaper_path.exists():
        subprocess.run(["jazz-wallpaper-set", str(wallpaper_path)], check=False)
    else:
        print(f"warning: wallpaper {wallpaper_path} missing, skipped wallpaper apply", file=sys.stderr)

    DATA_DIR.mkdir(parents=True, exist_ok=True)
    (DATA_DIR / "theme-state.json").write_text(json.dumps({"activeTheme": args.theme_id}))
    # No Quickshell relaunch needed here - Theme.qml's FileView (watchChanges)
    # picks this up live, confirmed live on the Yoga 6 via pixel sampling.

    print(f"Applied theme: {t['label']} ({args.theme_id})")


if __name__ == "__main__":
    main()
